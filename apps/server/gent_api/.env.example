# Django Configuration
SECRET_KEY=your-secret-key-here
DEBUG=False
DJANGO_SETTINGS_MODULE=gent_api.settings
ALLOWED_HOSTS=.onrender.com,yourdomain.com

# Database
# For PostgreSQL (recommended for Render)
DATABASE_URL=postgresql://user:password@host:5432/dbname
# For SQLite (not recommended for Render)
# DATABASE_URL=sqlite:///db.sqlite3

# CORS
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# Security
CSRF_TRUSTED_ORIGINS=https://your-api.onrender.com

# Email / password reset
# Provider-agnostic SMTP - works with Brevo, Mailjet, Gmail, Resend, anything.
# DEFAULT_FROM_EMAIL must be an address the provider has verified as a sender,
# otherwise it rejects the send.
#
# Brevo:   EMAIL_HOST=smtp-relay.brevo.com  EMAIL_PORT=587
#          EMAIL_HOST_USER=<your Brevo SMTP login>
#          EMAIL_HOST_PASSWORD=<your Brevo SMTP key>
# Gmail:   EMAIL_HOST=smtp.gmail.com  EMAIL_PORT=587
#          EMAIL_HOST_USER=<your gmail>  EMAIL_HOST_PASSWORD=<app password>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=
# Origin of the frontend; the reset link is built from this.
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TIMEOUT=3600

# Logging
LOG_LEVEL=INFO
