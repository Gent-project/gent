# Django Configuration
SECRET_KEY=your-secret-key-here
DEBUG=False
DJANGO_SETTINGS_MODULE=gent_api.settings
ALLOWED_HOSTS=.onrender.com,yourdomain.com

# Database
# For PostgreSQL (recommended for Render)
DATABASE_URL=postgresql://user:password@host:5432/dbname
# For SQLite (not recommended for Render)
# DATABASE_URL=sqlite:///db.sqlite3

# CORS
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# Security
CSRF_TRUSTED_ORIGINS=https://your-api.onrender.com

# Email / password reset
# Get an API key from https://resend.com (Resend is the email API - unrelated to
# Render, the host). Without it, no reset email is sent.
RESEND_API_KEY=
# onboarding@resend.dev needs no verified domain, but Resend will ONLY deliver
# to the address the Resend account was registered with. Replace this with an
# address on your own verified domain to send to arbitrary recipients.
DEFAULT_FROM_EMAIL=onboarding@resend.dev
# Origin of the frontend; the reset link is built from this.
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TIMEOUT=3600

# Logging
LOG_LEVEL=INFO
